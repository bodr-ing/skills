 "layouts": {
  "poster": "<div><div class=\"eb\" data-slot=\"eyebrow\"></div></div><h2 class=\"w\" data-slot=\"word\"></h2><div><div class=\"ln\" data-slot=\"line\"></div><div class=\"chips\"><span data-slot=\"p1\"></span><span data-slot=\"p2\"></span></div></div>",
  "bag": "<div class=\"pouch\"><div class=\"label\"><span class=\"roast\" data-slot=\"p2\"></span><h2 class=\"w\" data-slot=\"word\"></h2><span class=\"ln\" data-slot=\"line\"></span><span class=\"eb\" data-slot=\"weight\"></span></div></div>",
  "menu": "<h2 class=\"w\" data-slot=\"word\"></h2><ul><li><span data-slot=\"p1\"></span><i></i><b data-slot=\"price1\"></b></li><li><span data-slot=\"p2\"></span><i></i><b data-slot=\"price2\"></b></li><li><span data-slot=\"p3\"></span><i></i><b data-slot=\"price3\"></b></li></ul><div class=\"ln\" data-slot=\"line\"></div>",
  "post": "<div class=\"top\"><span class=\"av\"></span><span data-slot=\"handle\"></span></div><div class=\"pic\"><h2 class=\"w\" data-slot=\"word\"></h2></div><div class=\"cap\"><b data-slot=\"handle\"></b><span class=\"ln\" data-slot=\"line\"></span></div>"
 },
 "css": "/* Four places a coffee roaster's look actually lives: a shop poster, a bag label, the menu board, a social post.\n   Every card sets --bg --fg --ac (palette), --display --weight --style --size (type), --deco (pattern) and may set --body, --fine. */\n.spec { background: var(--deco), var(--bg); background-color: var(--bg); color: var(--fg); font-family: var(--body, \"Work Sans\"), system-ui, sans-serif; }\n.spec .w { font-family: var(--display), system-ui, sans-serif; font-weight: var(--weight); font-style: var(--style); line-height: .9; margin: 0; overflow-wrap: anywhere; }\n.spec .eb { font-size: var(--fine, 11px); letter-spacing: .14em; text-transform: uppercase; opacity: .75; font-family: var(--display), system-ui; }\n\n/* Shop poster: the brand word as big as it gets, a line and two product chips. */\n.L-poster { padding: 22px; display: flex; flex-direction: column; justify-content: space-between; }\n.L-poster .w { font-size: var(--size); }\n.L-poster .ln { font-size: 14px; max-width: 26ch; opacity: .85; line-height: 1.5; }\n.L-poster .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }\n.L-poster .chips span { font-size: 12px; padding: 5px 10px; border-radius: 999px; border: 1px solid var(--fg); }\n.L-poster .chips span:first-child { background: var(--ac); color: var(--bg); border-color: var(--ac); }\n\n/* Bag label: a kraft-free pouch drawn in the card colour, its label carrying the word, roast and tasting notes. */\n.L-bag { display: grid; place-items: center; padding: 26px 30px 22px; }\n.L-bag .pouch { width: 100%; height: 100%; max-width: 250px; background: var(--fg); color: var(--bg); border-radius: 10px 10px 18px 18px; position: relative;\n  display: flex; flex-direction: column; justify-content: center; padding: 18px; box-shadow: 0 16px 30px -18px rgba(0,0,0,.6); }\n.L-bag .pouch::before { content: \"\"; position: absolute; left: 0; right: 0; top: 0; height: 18px; border-radius: 10px 10px 0 0;\n  background: repeating-linear-gradient(90deg, rgba(0,0,0,.18) 0 3px, transparent 3px 7px); }\n.L-bag .label { background: var(--bg); color: var(--fg); border: 2px solid var(--ac); padding: 16px 14px; display: grid; gap: 8px; text-align: center; }\n.L-bag .w { font-size: calc(var(--size) * .62); }\n.L-bag .roast { font-size: 12px; font-weight: 600; color: var(--ac); text-transform: uppercase; letter-spacing: .1em; font-family: var(--display), system-ui; font-size: var(--fine, 12px); }\n.L-bag .ln { font-size: 12px; opacity: .8; line-height: 1.4; }\n\n/* Menu board: the brand small on top, three drinks with dotted leaders and prices, all set in the look's type. */\n.L-menu { padding: 22px 22px 18px; display: flex; flex-direction: column; gap: 14px; }\n.L-menu .w { font-size: calc(var(--size) * .5); }\n.L-menu ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; flex: 1; align-content: center; }\n.L-menu li { display: flex; align-items: baseline; gap: 8px; font-family: var(--display), system-ui; font-weight: var(--weight); font-style: var(--style); font-size: clamp(14px, calc(var(--size) * .3), 22px); line-height: 1.1; }\n.L-menu li i { flex: 1; border-bottom: 2px dotted currentColor; opacity: .4; transform: translateY(-4px); }\n.L-menu li b { color: var(--ac); font-weight: inherit; }\n.L-menu .ln { font-size: var(--fine, 13px); opacity: .8; border-top: 1px solid currentColor; padding-top: 10px; line-height: 1.45; }\n\n/* Social post: a header row, a square picture made of the look's pattern and word, a caption. */\n.L-post { display: flex; flex-direction: column; background: var(--bg); }\n.L-post .top { display: flex; align-items: center; gap: 8px; padding: 12px 14px; font-size: 13px; font-weight: 600; }\n.L-post .av { width: 28px; height: 28px; border-radius: 50%; background: var(--ac); }\n.L-post .pic { flex: 1; min-height: 0; display: grid; place-items: center; padding: 16px; background: var(--deco), var(--bg); background-color: var(--bg);\n  border-block: 1px solid color-mix(in srgb, var(--fg) 25%, transparent); text-align: center; }\n.L-post .w { font-size: calc(var(--size) * .8); }\n.L-post .cap { padding: 10px 14px 14px; font-size: 13px; line-height: 1.4; }\n.L-post .cap b { margin-right: 6px; }\n.L-post .ln { opacity: .85; font-size: var(--fine, 13px); }",
